#!/bin/sh
#
# pre-push：校验提交信息，跑全量 oxlint、两段类型检查与文档门禁。
#
# 与 pre-commit 的分工：pre-commit 只查本次提交涉及的文件，pre-push 查整个 src/ 并跑 tsc。
# 文档门禁与提交信息校验在这里无条件跑。
#
# 规则集见仓库根的 .oxlintrc.json。

set -e

root=$(git rev-parse --show-toplevel)
cd "$root"

# 标准输入是本钩子唯一的推送范围来源，只可读一次。
push_stdin=$(cat)
printf '%s' "$push_stdin" | node scripts/verify-commit-messages.mjs

if [ ! -f node_modules/oxlint/dist/cli.js ]; then
	echo "pre-push: 未找到 oxlint，请先运行 pnpm install。" >&2
	exit 1
fi

echo "pre-push: oxlint 全量检查 src/"
node node_modules/oxlint/dist/cli.js --type-aware src

echo "pre-push: 类型检查（宿主）"
node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit

echo "pre-push: 类型检查（客户端）"
node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit

echo "pre-push: 文档门禁"
node node_modules/tsx/dist/cli.mjs scripts/verify-all.ts

echo "pre-push: 通过"