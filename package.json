{
  "name": "dsh-source-control",
  "version": "0.5.0",
  "description": "dsh中的类vscode源代码管理页面",
  "license": "MIT",
  "author": "xzy-nine",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "commit-graph",
    "sidebar",
    "source-control",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzy-nine/dsh-source-control.git"
  },
  "bugs": {
    "url": "https://github.com/xzy-nine/dsh-source-control/issues"
  },
  "homepage": "https://github.com/xzy-nine/dsh-source-control#readme",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "icon": "./assets/icons/plugin-logo.svg",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/icons/plugin-logo.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build && node scripts/install-hooks.mjs",
    "typecheck": "pnpm run typecheck:host && pnpm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "pnpm run build",
    "test": "node --test test/*.test.mjs",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "sessions",
        "slots",
        "sidebarRight",
        "sidebarRightTabs"
      ]
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.3",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "blueimp-md5": "^2.19.0",
    "esbuild": "^0.24.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jsdom": "^30.1.3",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <=0.2.1-alpha.3"
  }
}
