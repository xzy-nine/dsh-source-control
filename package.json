{
  "name": "dsh-dev-git-graph",
  "version": "0.2.0",
  "description": "DSH 插件：内置右侧栏 Git Graph 页——提交图、变更列表与提交框，控件使用 DSH ui-primitives；host 直跑 git 命令。",
  "license": "MIT",
  "author": "xzy-nine",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "git-graph",
    "commit-graph",
    "sidebar",
    "source-control",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://example.com/xzy-nine/dsh-dev-git-graph.git"
  },
  "homepage": "https://example.com/xzy-nine/dsh-dev-git-graph#readme",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "vendor/git-graph/LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build",
    "typecheck": "pnpm run typecheck:host && pnpm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "pnpm run build:client",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "sessions",
        "slots",
        "sidebarRight",
        "sidebarRightTabs"
      ]
    }
  },
  "dependencies": {
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
