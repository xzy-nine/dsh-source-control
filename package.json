{
  "name": "dsh-source-control",
  "version": "1.0.0",
  "description": "dsh中的类vscode源代码管理页面",
  "license": "MIT",
  "author": "xzy-nine",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "git",
    "commit-graph",
    "sidebar",
    "source-control",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzy-nine/dsh-source-control.git"
  },
  "bugs": {
    "url": "https://github.com/xzy-nine/dsh-source-control/issues"
  },
  "homepage": "https://github.com/xzy-nine/dsh-source-control#readme",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "icon": "./assets/icons/plugin-logo.svg",
  "main": "./lib/src/index.js",
  "types": "./lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets/icons/plugin-logo.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:host && pnpm run build:client",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "prepublishOnly": "pnpm run build",
    "prepare": "pnpm run build && node scripts/install-hooks.mjs",
    "typecheck": "pnpm run typecheck:host && pnpm run typecheck:client",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "oxlint --type-aware src",
    "lint:fix": "oxlint --type-aware --fix src",
    "hooks:install": "node scripts/install-hooks.mjs",
    "check:duplication": "node scripts/check-duplication.mjs",
    "check:dual-track": "node scripts/check-dual-track-baseline.mjs",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-archived-agent-notes": "tsx scripts/verify-archived-agent-notes.ts",
    "verify-skill-invocation-metadata": "tsx scripts/verify-skill-invocation-metadata.ts",
    "test:docs": "tsx scripts/verify-all.ts",
    "pretest": "pnpm run build && pnpm run check:duplication && pnpm run check:dual-track",
    "test": "node --test --test-timeout=120000 --import ./test/setup.mjs test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <=0.2.2-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-alpha.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-context-menu": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.24.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "immer": "10.2.0",
    "js-yaml": "^4.1.0",
    "jscpd": "3.5.10",
    "jsdom": "^30.1.3",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "zustand": "4.5.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ~4.0.5 || ~4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.0-rc.2 <=0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.2 <=0.2.2-alpha.2"
  }
}
