{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@deepseek-ai/dsh-experimental-client-ui-forge/src/client/DiffFile.tsx": [
        "./node_modules/@deepseek-ai/dsh-experimental-client-ui-forge/lib/types/client/DiffFile.d.ts"
      ],
      "@deepseek-ai/dsh-experimental-client-ui-forge/src/client/section-reach.ts": [
        "./node_modules/@deepseek-ai/dsh-experimental-client-ui-forge/lib/types/client/section-reach.d.ts"
      ],
      "@deepseek-ai/dsh-experimental-client-ui-forge/src/client/locales.ts": [
        "./node_modules/@deepseek-ai/dsh-experimental-client-ui-forge/lib/types/client/locales.d.ts"
      ],
      "@deepseek-ai/dsh-experimental-client-ui-forge/src/client/viewed-files.ts": [
        "./node_modules/@deepseek-ai/dsh-experimental-client-ui-forge/lib/types/client/viewed-files.d.ts"
      ],
      "@deepseek-ai/dsh-experimental-client-ui-forge/types": [
        "./node_modules/@deepseek-ai/dsh-experimental-client-ui-forge/lib/types/types.d.ts"
      ]
    }
  },
  "include": [
    "src/client/**/*.ts",
    "src/client/**/*.tsx"
  ]
}
